WHATSAPP_PORT=3002
WHATSAPP_SERVICE_API_KEY=wavixa-local-api-key-2026
LARAVEL_API_URL=https://wavixa.net/api
LARAVEL_API_TOKEN=
NODE_ENV=production
WHATSAPP_AUTO_RESTORE=false

# Worker identity for horizontal scaling. Each worker only consumes its own queue.
WHATSAPP_WORKER_ID=worker-1

# Lower than the Baileys default because each session now runs a full
# Chromium instance which is much heavier on RAM.
MAX_CONCURRENT_SESSIONS=20

# Reconnect storm protection: queued, staggered reconnects instead of per-session timers.
# concurrency = how many reconnect attempts can be in-flight at the same time.
# interval_ms = minimum time between starting two reconnect attempts.
RECONNECT_QUEUE_CONCURRENCY=3
RECONNECT_QUEUE_INTERVAL_MS=2000
MAX_RECONNECT_ATTEMPTS=20

# Optional Redis backend for the reconnect queue (set to enable multi-worker mode).
# REDIS_URL=redis://127.0.0.1:6379

# --- Protection protocols ---
# Randomised typing simulation window (ms) for known contacts.
WHATSAPP_TYPING_MIN_MS=1500
WHATSAPP_TYPING_MAX_MS=4000
# Randomised "go offline after sending" window (ms).
WHATSAPP_IDLE_MIN_MS=5000
WHATSAPP_IDLE_MAX_MS=20000
# Optional global proxy (per-session proxy.txt / connect body overrides this).
# WHATSAPP_PROXY=http://user:pass@host:port
# Optional comma-separated proxy pool for sticky per-user assignment.
# WHATSAPP_PROXY_LIST=http://p1:port,socks5://p2:port
