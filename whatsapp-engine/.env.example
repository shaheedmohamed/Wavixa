# Wavixa WhatsApp Engine Environment Configuration
NODE_ENV=production
ENGINE_PORT=3005
ENGINE_HOST=127.0.0.1
ENGINE_WORKER_ID=worker-1
ENGINE_INTERNAL_SECRET=wavixa-local-api-key-2026
ENGINE_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Laravel Core Webhook Ingestion
LARAVEL_API_URL=https://wavixa.net/api
# Extra webhook targets (the separated CRM backend receives a copy of every webhook)
LARAVEL_API_URLS_EXTRA=http://127.0.0.1:8088/api
LARAVEL_WEBHOOK_TIMEOUT_MS=8000
WHATSAPP_SERVICE_API_KEY=wavixa-local-api-key-2026

# Redis Data Infrastructure
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_KEY_PREFIX=wavixa:wa:

# MySQL Relational Metadata & Vault
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=wavixa_db
DB_USERNAME=wavixa_user
DB_PASSWORD=wavixa_pass_2026

# Session Scaling & Resource Bounds
MAX_CONCURRENT_SESSIONS=1000
RECONNECT_MAX_RETRIES=15
RECONNECT_BASE_DELAY_MS=2000
RECONNECT_MAX_DELAY_MS=60000

# Safety Engine & Rate Limiter Defaults
DEFAULT_USER_RATE_LIMIT=60
DEFAULT_DEVICE_RATE_LIMIT=20
RISK_THRESHOLD_HIGH=60
RISK_THRESHOLD_BLOCK=80
