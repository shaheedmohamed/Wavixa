    "mysql2": "^3.12.0",
    "pino": "^9.6.0",
    "protobufjs": "^7.4.0",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/qrcode": "^1.5.5",
    "@types/ws": "^8.5.13",
    "eslint": "^8.57.1",
    "pino-pretty": "^13.0.0",
