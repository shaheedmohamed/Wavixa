APP_NAME=Wavixa
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="support@wavixa.net"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp Service Configuration
WHATSAPP_SERVICE_URL=http://localhost:3000
WHATSAPP_SERVICE_API_KEY=your-secret-api-key

# OpenRouter AI Configuration
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=google/gemini-2.5-flash

# Google Gemini (free tier) AI Configuration
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=
GEMINI_DEFAULT_MODEL=gemini-2.5-flash

# Meta Marketing API Configuration
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=
META_PIXEL_ID=
META_API_VERSION=v21.0

# Meta Official / Tech Provider Test Integration
# When enabled, a separate "Meta Test" module becomes available at /meta-test
META_OFFICIAL_TEST_ENABLED=false
META_TEST_WEBHOOK_VERIFY_TOKEN=
META_TEST_WEBHOOK_PATH=/api/meta-test/webhook
META_TEST_REDIRECT_URI=${APP_URL}/api/meta-test/callback
META_GRAPH_URL=https://graph.facebook.com
META_LOGIN_CONFIG_ID=
META_EMBEDDED_SIGNUP_FEATURE=whatsapp_business_app_onboarding
META_SESSION_INFO_VERSION=3

# Agora Real-Time Voice Configuration
# Get these from your Agora Console (https://console.agora.io)
# App Certificate is required for token generation; App ID alone is not enough for secure token-based channels.
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
AGORA_TOKEN_EXPIRATION=3600

# Optional: API key for Agora Conversational AI Engine to call your custom LLM endpoint.
# If set, the LLM endpoint at /api/voice/chat will require this key in the Authorization header.
AGORA_LLM_API_KEY=

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8000
